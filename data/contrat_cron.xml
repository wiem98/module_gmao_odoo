<odoo>
  <data noupdate="1">
    <record id="ir_cron_update_expired_contracts" model="ir.cron">
      <field name="name">Update Expired Maintenance Contracts</field>
      <field name="model_id" ref="model_maintenance_service_contract"/>
      <field name="state">code</field>
      <field name="code">model.update_expired_contracts()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active">True</field>
    </record>

    <record id="ir_cron_check_contract_renewal" model="ir.cron">
        <field name="name">Contract Renewal Alert</field>
        <field name="model_id" ref="model_maintenance_service_contract"/>
        <field name="state">code</field>
        <field name="code">model.check_contract_renewal()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    
  </data>
</odoo>
