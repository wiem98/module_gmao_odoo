<odoo>

  <menuitem id="menu_gmao_root"
            name="GMAO"
            sequence="10"
            web_icon="gmao_maintenance,static/description/icon.png"/>

  <!-- Main Menu for Maintenance (Plans and Contracts) -->
  <menuitem id="menu_maintenance_plan_root"
            name="Maintenance"
            parent="menu_gmao_root"
            sequence="10"/>


  <menuitem id="menu_gmao_tickets"
            name="Intervention Tickets"
            parent="menu_gmao_root"
            sequence="20"/> 


  <menuitem id="menu_gmao_maintenance_request"
            name="All Tickets"
            parent="menu_gmao_tickets"
            action="action_gmao_maintenance_request"
            sequence="10"/>

  <menuitem id="menu_gmao_my_tasks"
          name="My Tasks"
          parent="menu_gmao_tickets"
          action="action_gmao_my_tasks"
          sequence="20"/>

<menuitem id="menu_gmao_projects"
          name="Projects"
          parent="menu_gmao_root"
          action="action_gmao_project"
          sequence="30"/>

  <menuitem id="menu_gmao_equipment"
            name="Equipment"
            parent="menu_gmao_root"
            action="action_gmao_equipment_list"
            sequence="40"/>


<menuitem id="menu_maintenance_service_contract"
          name="Maintenance Service Contracts"
          parent="menu_maintenance_plan_root"
          action="action_maintenance_service_contract"
          sequence="10"/>

<menuitem id="menu_maintenance_plan"
          name="Maintenance Plans"
          parent="menu_maintenance_plan_root"
          action="action_maintenance_plan"
          sequence="20"/>

  <menuitem id="menu_bt_root" 
            name="Bon de Travail (BT)" 
            parent="menu_gmao_root" 
            action="action_gmao_bt" 
            sequence="50"/>

  <menuitem id="menu_configuration" name="Configuration" 
            parent="menu_gmao_root" 
            sequence="60"/>

  <!-- Submenu for Equipment Categories -->
  <menuitem id="menu_maintenance_category"
            name="Equipment Category"
            parent="menu_configuration"
            action="action_gmao_equipment_category"
            sequence="10"/>

  <menuitem id="menu_maintenance_teams"
          name="Maintenance Teams"
          parent="menu_configuration"
          action="action_gmao_maintenance_teams"
          sequence="20"/>
</odoo>
