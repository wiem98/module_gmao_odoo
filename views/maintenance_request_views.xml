<odoo>
  <data>
    <!-- Form view inheritance -->
    <record id="view_maintenance_request_form_inherit" model="ir.ui.view">
      <field name="name">maintenance.request.form.inherit.criticity.project</field>
      <field name="model">maintenance.request</field>
      <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
      <field name="arch" type="xml">
  
        <xpath expr="//header" position="inside">
          <div invisible="id == False ">
            <button name="open_or_create_plan" 
                    type="object" 
                    string="Create Maintenance Plan" 
                    class="btn-primary oe_highlight"/>
          </div>
        </xpath>

        <xpath expr="//field[@name='maintenance_type']" position="replace">
          <field name="maintenance_type" widget="selection"/>
        </xpath>

        <xpath expr="//field[@name='priority']" position="after">
          <field name="criticity"/>
        </xpath>

        <xpath expr="//field[@name='equipment_id']" position="after">
          <field name="project_id" domain="[('stage_id.name', '=', 'Done')]"/>
        </xpath>

      <!-- <xpath expr="//field[@name='duration']" position="attributes">
          <attribute name="string">Estimated Duration</attribute>
      </xpath>

      <xpath expr="//field[@name='schedule_date']" position="after">
          <field name="total_task_duration" string="Actual Hours Spent" readonly="1"/>
      </xpath> -->

      <!-- Replace your duration-related xpaths with this: -->
        <xpath expr="//field[@name='duration']/.." position="after">
            <!-- <field name="total_task_duration" string="Actual Hours Spent" readonly="1"/> -->
            <label for="total_task_duration" invisible="total_task_duration == 0"/>
            <div invisible="total_task_duration == 0">
              <field name="total_task_duration" widget="float_time" class="oe_inline" readonly="1"/>
              <span> hours</span>
              </div>
        </xpath>

        <xpath expr="//field[@name='duration']" position="attributes">
            <attribute name="string">Estimated Duration</attribute>
        </xpath>

        <xpath expr="//notebook" position="inside">
              <page string="Maintenance Plans" invisible="id == False ">
                <field name="maintenance_plan_ids">
                  <list editable="bottom">
                    <field name="name"/>
                    <field name="maintenance_type"/>
                    <field name="interval_number"/>
                    <field name="interval_type"/>
                    <field name="next_date"/>
                    <field name="active"/>
                  </list>
                </field>
              </page>
            </xpath>
     
      </field>
    </record>

    <!-- Tree view inheritance -->
    <record id="view_maintenance_request_tree_inherit_criticity" model="ir.ui.view">
      <field name="name">maintenance.request.tree.inherit.criticity</field>
      <field name="model">maintenance.request</field>
      <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='stage_id']" position="after">
          <field name="criticity"/>
          <field name="maintenance_type"/>
        </xpath>
      </field>
    </record>

    <!-- Kanban view inheritance -->
    <record id="view_maintenance_request_kanban_inherit_criticity" model="ir.ui.view">
      <field name="name">maintenance.request.kanban.inherit.criticity</field>
      <field name="model">maintenance.request</field>
      <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban"/>
      <field name="arch" type="xml">
        <xpath expr="//t[@t-name='card']/field[@name='name']" position="after">
          <div>
            <span class="badge badge-info">Criticity: <field name="criticity"/></span>
          </div>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
